{
  "name": "neurosignal-trace-viewer-workspace",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "npm run lint --workspaces --if-present && eslint playwright.config.ts tests/browser",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "playwright test",
    "check:pack": "node scripts/check-package.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:real-data": "node scripts/check-real-data.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
